---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company } from "../data/company";
---

<BaseLayout title="Apps" description={`Apps from ${company.legalName}, including ${company.product.name}.`}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-20">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Our apps</h1>
    <p class="mt-3 text-lg text-slate-600 max-w-2xl">
      We're a single-product studio for now. Here's what we're working on.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <article class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="flex items-start gap-4">
          <div
            class="h-14 w-14 shrink-0 rounded-2xl bg-slate-900 text-white flex items-center justify-center font-bold text-lg"
            aria-hidden="true"
          >
            P
          </div>
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-2xl font-semibold text-slate-900">{company.product.name}</h2>
              <span
                class="inline-flex items-center rounded-full bg-amber-100 text-amber-800 px-2.5 py-0.5 text-xs font-medium"
              >
                {company.product.status}
              </span>
            </div>
            <p class="mt-2 text-slate-600 leading-relaxed">
              {company.product.blurb}
            </p>
          </div>
        </div>

        <ul class="mt-6 grid gap-2 text-sm text-slate-600">
          <li>• Real practice questions modeled on official state DMV tests</li>
          <li>• Smart review that focuses on what you keep getting wrong</li>
          <li>• Works offline — study on the train, in line, anywhere</li>
        </ul>

        <div class="mt-6 text-sm text-slate-500">
          Product site (preview): <span class="font-mono">{company.product.productSiteText}</span>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <span
            class="inline-flex items-center rounded-md bg-slate-100 px-4 py-2 text-sm font-medium text-slate-500 cursor-not-allowed"
            aria-disabled="true"
          >
            App Store — coming soon
          </span>
          <span
            class="inline-flex items-center rounded-md bg-slate-100 px-4 py-2 text-sm font-medium text-slate-500 cursor-not-allowed"
            aria-disabled="true"
          >
            Google Play — coming soon
          </span>
        </div>
      </article>

      <article
        class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-8 flex items-center justify-center text-center"
      >
        <div>
          <p class="text-sm font-medium text-slate-500 uppercase tracking-wide">More to come</p>
          <p class="mt-2 text-slate-600 max-w-xs">
            We have ideas for adjacent test-prep categories. We'll announce them when they're real
            — not before.
          </p>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
