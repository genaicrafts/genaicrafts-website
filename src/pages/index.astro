---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company } from "../data/company";

const features = [
  {
    title: "Built for retention",
    body: "Spaced repetition, real practice tests, and clear explanations — designed so you actually remember what you study.",
  },
  {
    title: "Native iOS & Android",
    body: "First-class mobile experiences. Fast, offline-capable, and made to feel right on every device.",
  },
  {
    title: "Privacy-first",
    body: "We collect only what's needed to make the app work. No ad networks. No selling your data. Ever.",
  },
];
---

<BaseLayout title={company.legalName} description={company.description}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-12 md:pt-24 md:pb-20">
    <p class="text-sm font-medium text-slate-500 uppercase tracking-wide">
      An independent {company.state} studio
    </p>
    <h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight text-slate-900 leading-tight">
      {company.tagline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600 leading-relaxed">
      We're {company.legalName}, a small team focused on education apps for high-stakes
      tests. Our flagship app is launching soon.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/apps"
        class="inline-flex items-center rounded-md bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-800 transition-colors"
        >See our apps →</a
      >
      <a
        href="/about"
        class="inline-flex items-center rounded-md border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors"
        >About us</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="grid gap-6 md:grid-cols-3">
      {
        features.map((f) => (
          <div class="rounded-lg border border-slate-200 bg-white p-6">
            <h3 class="text-base font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{f.body}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
